# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs & local state / environments (never commit)
*.log
.local/
.local-recovery/
.runtime/
.pixi/
log/
*.img.xz

# Bench artifacts too large for git (regenerate per docs/USER_GUIDE.md).
# Compact measured reports are re-included explicitly, per directory.
bench/results/*
!bench/results/2026-11-01-pc-visual/
bench/local-baselines/
*.h264
*.nv12
bench/*_probe.png

# Model binaries are not committed. The single pre-existing tracked HEF is the only
# exception (see models/LICENCES.md); any other HEF stays out until an explicit review.
*.hef
!models/yolo_world_v2s_h10.hef
models/*.onnx
models/clip_*tokenizer.json

# Generated testing-release sample (packaged by release/build.py)
samples/*.avi
