<?xml version="1.0"?>
<!-- Bench only. Actor: Mingfei, actor v1, CC BY 4.0; see dependencies doc. -->
<sdf version="1.9">
  <world name="garuda_lab">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>47.397971</latitude_deg><longitude_deg>8.546164</longitude_deg><elevation>0</elevation></spherical_coordinates>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.65 0.78 0.88 1</background><shadows>true</shadows><grid>false</grid></scene>
    <light name="sun" type="directional"><pose>0 0 20 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.1 -0.9</direction><cast_shadows>true</cast_shadows></light>
    <model name="ground"><static>true</static><link name="ground">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="grass"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.22 0.32 0.23 1</ambient><diffuse>0.32 0.43 0.31 1</diffuse></material></visual>
    </link></model>
    <model name="walkway"><static>true</static><pose>9 0 0.006 0 0 0</pose><link name="path"><visual name="path"><geometry><box><size>24 4 0.01</size></box></geometry><material><ambient>0.48 0.48 0.43 1</ambient><diffuse>0.6 0.6 0.55 1</diffuse></material></visual></link></model>
    <model name="occluder"><static>true</static><pose>11 3.5 1 0 0 0</pose><link name="wall"><collision name="wall"><geometry><box><size>1 1 2</size></box></geometry></collision><visual name="wall"><geometry><box><size>1 1 2</size></box></geometry><material><ambient>0.22 0.3 0.38 1</ambient><diffuse>0.3 0.4 0.5 1</diffuse></material></visual></link></model>
    <actor name="walker">
      <skin><filename>@ACTOR_MESH@</filename><scale>1</scale></skin>
      <animation name="walk"><filename>@ACTOR_MESH@</filename><interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><auto_start>true</auto_start><trajectory id="0" type="walk">
        <waypoint><time>0</time><pose>6 0 1 0 0 0</pose></waypoint>
        <waypoint><time>30</time><pose>6 0 1 0 0 0</pose></waypoint>
        <waypoint><time>50</time><pose>9 1 1 0 0 0</pose></waypoint>
        <waypoint><time>54</time><pose>9 1 1 0 0 3.14159</pose></waypoint>
        <waypoint><time>74</time><pose>6 -1 1 0 0 3.14159</pose></waypoint>
        <waypoint><time>78</time><pose>6 0 1 0 0 0</pose></waypoint>
      </trajectory></script>
    </actor>
    <model name="garuda_x500">
      <include merge="true"><uri>model://x500</uri></include>
      <link name="follow_camera">
        <pose relative_to="base_link">0.15 0 0.18 0 0.12 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz></inertia></inertial>
        <!-- RGB and depth share one optical origin, resolution and projection. -->
        <sensor name="rgbd" type="rgbd_camera"><topic>/garuda/drone</topic><always_on>true</always_on><update_rate>20</update_rate>
          <camera><horizontal_fov>1.2</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>40</far></clip></camera>
        </sensor>
      </link>
      <joint name="follow_camera_mount" type="fixed"><parent>base_link</parent><child>follow_camera</child></joint>
    </model>
    <model name="overview"><static>true</static><pose>-5 -10 10 0 0.55 0.6</pose><link name="camera">
      <sensor name="overview" type="camera"><topic>/garuda/overview</topic><always_on>true</always_on><update_rate>8</update_rate><camera><horizontal_fov>1.3</horizontal_fov><image><width>800</width><height>450</height></image><clip><near>0.1</near><far>100</far></clip></camera></sensor>
    </link></model>
  </world>
</sdf>
