[Unit]
Description=Garuda CamArray stereo-depth explorer (:8097) — bench depth engine + model switcher
After=network.target

[Service]
User=garuda
WorkingDirectory=/home/garuda/garuda-sdk-deploy/hosts/pi5
ExecStart=/usr/bin/python3 -u /home/garuda/garuda-sdk-deploy/hosts/pi5/camarray_depth_explorer.py
# Restart=always: a model switch exits the process on purpose so a FRESH process (and a reset
# Hailo device — full process death is what clears a wedged NPU) loads the newly-picked engine.
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
